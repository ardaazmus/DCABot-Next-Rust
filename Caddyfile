# Faz 14-B: Caddyfile — dinleyiciyi localhost'a kisitla (LAN'a acik :81 yerine).
# Dis acilis Cloudflare Tunnel uzerinden olacak; Caddy LAN proxy'si gereksiz
# olan yuzeyi kaldirir. Tunnel dogrudan 3000/3002'ye baglanabilir.
{
	admin off
}

http://localhost:81 {
	# Tüm /api/* istekleri Next.js middleware üzerinden geçirilir.
	# Middleware /api/engine/* rotalarına Bearer token ekler (SEC-01).
	# /api/health ve /api/stream özel durumlar tarafından Next.js'de işlenir.
	handle /api/* {
		reverse_proxy localhost:3000
	}

	handle {
		reverse_proxy localhost:3000
	}
}
